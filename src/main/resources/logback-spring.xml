<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="energymng"/>

    <!-- ─── Development: readable colored console ─────────────────────────── -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) [%boldYellow(%X{traceId:-no-trace})/%X{spanId:-}] [%boldMagenta(%X{module:-})] %cyan(%logger{36}) - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ─── Production: structured JSON (LogstashEncoder) ────────────────── -->
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"app":"${appName}"}</customFields>
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <message>message</message>
                <logger>logger</logger>
                <thread>thread</thread>
                <level>level</level>
            </fieldNames>
            <!-- traceId/spanId already in MDC via Micrometer; include all MDC keys -->
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>spanId</includeMdcKeyName>
            <includeMdcKeyName>module</includeMdcKeyName>
        </encoder>
    </appender>

    <!-- ─── Profile routing ───────────────────────────────────────────────── -->
    <springProfile name="prod | json">
        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
        </root>
        <logger name="br.com.energymng" level="INFO"/>
        <logger name="org.springframework.modulith" level="INFO"/>
    </springProfile>

    <springProfile name="!(prod | json)">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="br.com.energymng" level="DEBUG"/>
        <logger name="org.springframework.modulith" level="INFO"/>
        <logger name="org.hibernate.SQL" level="DEBUG"/>
    </springProfile>

</configuration>
